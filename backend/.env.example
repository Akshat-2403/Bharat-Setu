# Local development defaults (copy to backend/.env). Production requires all
# three variables below; DATABASE_URL must be managed PostgreSQL.
ENVIRONMENT=development
JWT_SECRET_KEY=local-development-only-change-this-secret
DATABASE_URL=sqlite:///./bharatsetu.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ACCESS_TOKEN_EXPIRE_MINUTES=30
UPLOAD_DIR=../uploads
STORAGE_BACKEND=local
# Required when STORAGE_BACKEND=s3 (Cloudflare R2 or another S3-compatible service)
S3_ENDPOINT_URL=
S3_BUCKET_NAME=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
ENABLE_DEMO_SEED=true

# Optional application integrations
VERIFICATION_MODE=mock
LLM_PROVIDER=mock
LLM_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=60
OCR_ENABLED=true
EMAIL_NOTIFICATIONS_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
NOTIFICATION_FROM_EMAIL=
SMS_NOTIFICATIONS_ENABLED=false
SMS_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
NOTIFICATION_TIME_ZONE=UTC
NOTIFICATION_ACTION_URL=
DEADLINE_REMINDER_INTERVAL_SECONDS=60
